# @verevoir/editor-premium is private and lives on GitHub Packages. npm
# routes registries per scope, not per package, so the whole @verevoir
# scope has to resolve here — every public package is mirrored to GitHub
# Packages by CI for exactly this reason (GitHub Packages does not fall
# through to npmjs).
#
# Needs a token with read:packages. Locally: export NODE_AUTH_TOKEN=$(gh auth token)
# In CI: NODE_AUTH_TOKEN=${{ secrets.GITHUB_TOKEN }}
@verevoir:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
