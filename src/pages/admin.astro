---
import { AdminShell, DocumentList } from '@verevoir/admin';
import type { DocumentListGroup } from '@verevoir/admin';
import '@verevoir/admin/styles/admin.css';
import { storage } from '@/storage';
import { ensureSeeded } from '@data/init';
import { blocks } from '@schema/registry';

export const prerender = false;

await ensureSeeded();

// Build one DocumentList group per registered block type. The
// admin's DocumentList is purely presentational — the data
// fetching lives in the route, in whatever shape the host wants.
const groups: DocumentListGroup[] = await Promise.all(
    Object.entries(blocks).map(async ([blockType, entry]) => ({
        blockType,
        entry,
        documents: await storage.list(blockType),
    })),
);
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width,initial-scale=1" />
        <title>Admin · Verevoir Starter</title>
        <link
            href="https://fonts.googleapis.com/css2?family=Mulish:ital,wght@0,400..900;1,400..900&display=swap"
            rel="stylesheet"
        />
    </head>
    <body>
        <AdminShell
            title="Verevoir Admin"
            headerActions={undefined}
            navLinks={[{ label: 'View site →', href: '/' }]}
        >
            <DocumentList groups={groups} />
        </AdminShell>
    </body>
</html>
