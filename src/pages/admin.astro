---
import { loadAdminGroups } from "@verevoir/admin/server";
import "@verevoir/admin/styles/admin.css";
import "@/styles/admin-theme.css";
import { storage } from "@/storage";
import { ensureSeeded } from "@data/init";
import { blocks } from "@schema/registry";
import { AdminHomeIsland } from "@/admin/AdminHomeIsland";

export const prerender = false;

await ensureSeeded();

// Server-side load: returns a serialisable view model that the
// AdminProvider feeds into the sidebar / document list. The full
// registry (with class instances) stays on the server.
const groups = await loadAdminGroups({ storage, blocks });
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width,initial-scale=1" />
        <title>Admin · Verevoir Starter</title>
        <link
            href="https://fonts.googleapis.com/css2?family=Mulish:ital,wght@0,400..900;1,400..900&display=swap"
            rel="stylesheet"
        />
    </head>
    <body>
        <AdminHomeIsland
            client:only="react"
            groups={groups}
            basePath="/admin"
            currentPath={Astro.url.pathname}
        />
    </body>
</html>
