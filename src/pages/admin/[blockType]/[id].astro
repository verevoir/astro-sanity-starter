---
import { loadAdminGroups } from "@verevoir/admin/server";
import type { LinkablePage } from "@verevoir/admin";
import "@verevoir/admin/styles/admin.css";
import "@/styles/admin-theme.css";
import { storage } from "@/storage";
import { ensureSeeded } from "@data/init";
import { blocks, sections } from "@schema/registry";
import { AdminEditorIsland } from "@/admin/AdminEditorIsland";
import type { VersioningData } from "@/admin/AdminEditorIsland";
import { pageVersionStore } from "@/server/page-versions";
import type { VersionRecord } from "@verevoir/editor/version-store";

export const prerender = false;

await ensureSeeded();

const { blockType, id } = Astro.params;

if (!blockType || !id) {
    return Astro.redirect("/admin");
}

const entry = blocks[blockType];
if (!entry) {
    return new Response(`Unknown block type: ${blockType}`, { status: 404 });
}

const doc = await storage.get(id);
if (!doc || doc.blockType !== blockType) {
    return new Response("Document not found", { status: 404 });
}

const data = doc.data as Record<string, unknown>;

// Extract just the schema-modeled fields for the metadata editor.
// Polymorphic fields (e.g. `sections` on a page) are handled
// separately by SectionsEditor inside DocumentEditor. Other fields
// not covered by either are preserved on save via the merge.
const schemaFields = Object.keys(entry.block.fields);
const editorData = Object.fromEntries(
    schemaFields.map((key) => [key, data[key]]),
);

const hasSections = blockType === "page";
const initialSections = hasSections
    ? ((data.sections as Array<{ _type: string; [key: string]: unknown }>) ??
      [])
    : [];

// Build the list of pages the LinkField picker can target.
const allPages = await storage.list("page");
const linkablePages: LinkablePage[] = allPages.map((p) => {
    const pd = p.data as { title?: string; slug?: string };
    return {
        id: p.id,
        title: pd.title ?? "(untitled)",
        url: pd.slug ?? "/",
        blockType: "page",
    };
});

// Live preview URL via the entry's `preview` function (if defined).
const previewUrl = entry.preview ? entry.preview(data) : undefined;
const hasPreview = previewUrl !== undefined;

const displayName =
    (data.title as string | undefined) ??
    (data.headerTitle as string | undefined) ??
    "(untitled)";

// Sidebar context — same view model the home page uses.
const groups = await loadAdminGroups({ storage, blocks });

// Versioning bundle for blockType=page. Other types render without
// versioning — DocumentEditor falls back to the single-doc Save
// flow when `versioning` is omitted.
let versioningData: VersioningData | undefined;
if (blockType === "page") {
    const record = (await pageVersionStore.getById(id)) as
        | VersionRecord
        | null;
    if (record) {
        const versions =
            (await pageVersionStore.listVersions(record.slug)) as VersionRecord[];
        versioningData = {
            record,
            versions,
            publishUrl: "/api/admin/page-publish",
            unpublishUrl: "/api/admin/page-unpublish",
            newVersionUrl: "/api/admin/page-new-version",
            versionPath: `/admin/${blockType}`,
        };
    }
}
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width,initial-scale=1" />
        <title>Edit {displayName} · Verevoir Admin</title>
        <link
            href="https://fonts.googleapis.com/css2?family=Mulish:ital,wght@0,400..900;1,400..900&display=swap"
            rel="stylesheet"
        />
    </head>
    <body>
        <AdminEditorIsland
            client:only="react"
            groups={groups}
            basePath="/admin"
            currentPath={Astro.url.pathname}
            breadcrumbs={[
                { label: entry.label ?? blockType, href: "/admin" },
                { label: displayName },
            ]}
            hasPreview={hasPreview}
            editor={{
                id,
                blockType,
                initialData: editorData,
                block: entry.block,
                previewUrl,
                sectionTypes: hasSections ? sections : undefined,
                initialSections,
                linkablePages,
            }}
            versioningData={versioningData}
        />
    </body>
</html>
