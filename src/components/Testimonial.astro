---
import { marked } from 'marked';

interface Props {
    quote?: string;
    authorName?: string;
    authorTitle?: string;
    company?: string;
    class?: string;
}

const { quote, authorName, authorTitle, company, class: className } = Astro.props;
---

<div class:list={['card', 'card-border', 'w-full max-w-2xl', className]}>
    <div class="text-left card-body">
        {company && <div class="mb-4 font-bold"><span>{company}</span></div>}
        {quote && <blockquote class="text-lg sm:text-xl" set:html={marked.parse(quote)} />}
        {
            authorName && (
                <div class="flex flex-col gap-4 mt-4">
                    <div class="font-bold">
                        <!-- prettier-ignore -->
                        <span>{authorName}</span>{authorTitle && (<>{', '}<span>{authorTitle}</span></>)}
                    </div>
                </div>
            )
        }
    </div>
</div>
