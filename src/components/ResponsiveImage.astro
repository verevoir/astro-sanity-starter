---
import { Image } from 'astro:assets';

interface Props {
    src: string;
    width?: number;
    height?: number;
    alt?: string;
    class?: string;
}

const { src, width, height, alt, class: className } = Astro.props;

const isSvg = src?.includes('.svg');
---

{
    isSvg ? (
        <img src={src} width={width} height={height} alt={alt || ''} class={className} />
    ) : (
        <Image src={src} width={width!} height={height!} alt={alt || ''} format="webp" class:list={className} />
    )
}
