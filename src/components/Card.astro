---
import { marked } from 'marked';
import { type Card } from 'types';
import Action from '@components/Action.astro';
import Badge from '@components/Badge.astro';
import ResponsiveImage from '@components/ResponsiveImage.astro';

interface Props extends Card {
    class?: string;
}

const {
    badge,
    heading,
    body,
    cta,
    ctaLabel,
    ctaUrl,
    image,
    theme,
    textAlign,
    hasBorder,
    class: className,
} = Astro.props;

// Compose the CTA list. Backwards-compatible: legacy `cta` array
// still wins. If absent, fall back to the simpler ctaLabel + ctaUrl
// pair the cards schema now exposes.
const actions =
    cta && cta.length > 0
        ? cta
        : ctaLabel && ctaUrl
            ? [{ _type: 'actionLink' as const, label: ctaLabel, url: ctaUrl }]
            : undefined;
---

<div
    class:list={['card', hasBorder !== false && 'card-border', 'w-full max-w-2xl', className]}
    {...theme && theme !== 'transparent' && { 'data-theme': theme }}
>
    {
        image && image.src && (
            <figure>
                <ResponsiveImage src={image.src} width={image.dimensions?.width} height={image.dimensions?.height} alt={image.alt} />
            </figure>
        )
    }
    <div class:list={['card-body gap-4', textAlign === 'center' ? 'items-center text-center' : 'text-left']}>
        {badge && badge.label && <Badge {...badge} />}
        {
            heading && (
                <h3 class="font-black card-title sm:text-2xl">
                    {heading}
                </h3>
            )
        }
        {body && <div class="markdown" set:html={marked.parse(body)} />}
        {
            actions && actions.length > 0 && (
                <div class="card-actions items-center">
                    {actions.map((item) => (
                        <Action
                            action={item}
                            class:list={[item._type === 'actionLink' ? 'font-bold underline hover:no-underline' : 'px-4 py-2.5 h-auto min-h-0']}
                        />
                    ))}
                </div>
            )
        }
    </div>
</div>
